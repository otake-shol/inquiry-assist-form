{
  "name": "inquiry-assist-form",
  "private": true,
  "version": "0.0.0",
  "description": "AI補助つき問い合わせフォーム",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "verify": "npm run verify:backend && npm run verify:frontend",
    "verify:backend": "bash scripts/gradle.sh check --console=plain",
    "verify:frontend": "npm --prefix frontend run verify",
    "dev:backend": "bash scripts/gradle.sh bootRun --console=plain",
    "dev:frontend": "npm --prefix frontend run dev",
    "smoke": "npm --prefix frontend run smoke"
  }
}
